{
	"name": "@goede/vue-gradientpicker",
	"version": "1.0.3",
	"description": "## Project setup ``` npm install ```",
	"author": "Bobbie Goede <bobbiegoede@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bobbiegoede/vue-gradientpicker"
	},
	"keywords": [
		"gradient",
		"gradientpicker",
		"picker",
		"vue",
		"vuejs"
	],
	"type": "module",
	"exports": {
		".": {
			"require": "./dist/vue-gradientpicker.cjs.js",
			"import": "./dist/vue-gradientpicker.es.js"
		},
		"./GradientPicker": {
			"require": "./dist/vue-gradientpicker.cjs.js",
			"import": "./dist/vue-gradientpicker.es.js"
		},
		"./dist/style.css": {
			"import": "./dist/style.css"
		}
	},
	"main": "./dist/vue-gradientpicker.cjs.js",
	"module": "./dist/vue-gradientpicker.es.js",
	"files": [
		"dist/*"
	],
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint .",
		"typecheck": "vue-tsc --noEmit"
	},
	"dependencies": {
		"d3-color": "^3.1.1",
		"d3-interpolate": "^3.0.2",
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@types/d3-color": "^3.1.3",
		"@types/d3-interpolate": "^3.0.4",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.15.0",
		"eslint-plugin-vue": "^10.12.1",
		"prettier": "^3.10.1",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vue-tsc": "^3.3.14"
	}
}
